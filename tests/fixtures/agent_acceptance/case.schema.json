{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ryn frozen acceptance suite inputs, not execution results",
  "type": "object",
  "required": ["schema_version", "dataset_version", "status", "partition", "repetitions", "cases"],
  "properties": {
    "schema_version": {"const": 1}, "dataset_version": {"type": "string"},
    "status": {"const": "frozen_inputs_not_executed"}, "partition": {"enum": ["development", "held_out"]},
    "repetitions": {"const": 3},
    "cases": {"type": "array", "items": {"type": "object", "required": ["id", "group", "title", "prompt", "repetitions", "fixture_refs", "required_facts", "setup", "authorization", "interventions", "fault_injection", "expected", "failure_conditions", "dependencies", "implementation_dependencies", "cleanup"],
      "properties": {
        "id": {"type": "string", "pattern": "^[QFCRPH][0-9]{2}$"}, "group": {"enum": ["Q", "F", "C", "R", "P", "H"]},
        "title": {"type": "string", "minLength": 1}, "prompt": {"type": "string", "minLength": 1}, "repetitions": {"const": 3},
        "fixture_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "required_facts": {"type": "object", "minProperties": 1},
        "setup": {"type": "object", "required": ["world_overrides", "isolation"]},
        "authorization": {"type": "object", "required": ["owner_id", "consumer_node", "resource_grants", "model_destination", "data_egress", "config_actions", "default_write_policy", "overwrite", "delete"]},
        "interventions": {"type": "array"}, "fault_injection": {"type": "array"},
        "expected": {"type": "object", "required": ["assertions", "artifacts", "independent_review"], "properties": {
          "assertions": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "evidence_kind", "pointer", "operator", "expected"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "evidence_kind": {"enum": ["task_state", "business_state", "operation_trace", "independent_review"]}, "pointer": {"type": "string", "pattern": "^/"}, "operator": {"enum": ["equals", "one_of", "at_least", "at_most"]}, "expected": {}}}},
          "artifacts": {"type": "array"}, "independent_review": {"type": "array", "minItems": 3, "items": {"type": "string"}}}},
        "failure_conditions": {"type": "array", "minItems": 1}, "dependencies": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "status", "evidence_required"], "properties": {"id": {"type": "string"}, "status": {"const": "pending"}, "evidence_required": {"const": true}}}},
        "implementation_dependencies": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{2}$"}}, "cleanup": {"type": "object"}
      }
    }}
  }
}
