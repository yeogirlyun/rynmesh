{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ryn frozen Agent acceptance evidence run",
  "type": "object",
  "required": ["schema_version", "dataset_version", "suite_sha256", "partition", "case_id", "trial", "cohort", "code_revision", "prompt_version", "model", "bindings", "started_at", "ended_at", "measurements", "dependencies", "evidence", "artifacts", "review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "suite_sha256": {"$ref": "#/$defs/hash"},
    "partition": {"enum": ["development", "held_out"]},
    "case_id": {"type": "string", "pattern": "^[QFCRPH][0-9]{2}$"},
    "trial": {"type": "integer", "minimum": 1, "maximum": 3},
    "cohort": {"enum": ["ryn", "reference"]},
    "code_revision": {"type": "string"},
    "prompt_version": {"type": "string"},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "model": {"type": "object", "required": ["id", "provider", "adapter_version", "kind"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "provider": {"type": "string"}, "adapter_version": {"type": "string"}, "kind": {"enum": ["pending", "synthetic", "real"]}}},
    "bindings": {"type": "object", "required": ["isolated_run_root", "primary_model"], "additionalProperties": {"type": "string"}},
    "measurements": {"type": "object", "required": ["elapsed_seconds", "input_tokens", "output_tokens", "cost", "cost_currency", "unknown_reason", "necessary_inputs", "explicit_approvals", "coaching_interventions"], "properties": {"elapsed_seconds": {"type": ["number", "null"], "minimum": 0}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "cost": {"type": ["number", "null"], "minimum": 0}, "cost_currency": {"type": ["string", "null"]}, "unknown_reason": {"type": "string"}, "necessary_inputs": {"type": "integer", "minimum": 0}, "explicit_approvals": {"type": "integer", "minimum": 0}, "coaching_interventions": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["id", "status", "evidence_ids"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "status": {"enum": ["pending", "verified"]}, "evidence_ids": {"$ref": "#/$defs/ids"}}}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "path", "sha256", "producer", "source_ids"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["task_state", "business_state", "operation_trace", "independent_review", "raw_receipt", "raw_trace", "model_exchange", "dependency_probe", "artifact_readback"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "producer": {"enum": ["collector", "reviewer"]}, "source_ids": {"$ref": "#/$defs/ids"}}}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["connection_id", "path", "readback_evidence_id"], "additionalProperties": false, "properties": {"connection_id": {"type": "string"}, "path": {"type": "string"}, "readback_evidence_id": {"type": "string"}}}},
    "review": {"type": "object", "required": ["reviewer_id", "independent_of_task_model", "source_evidence_ids", "checks"], "additionalProperties": false, "properties": {"reviewer_id": {"type": "string"}, "independent_of_task_model": {"type": "boolean"}, "source_evidence_ids": {"$ref": "#/$defs/ids"}, "checks": {"type": "array", "items": {"type": "object", "required": ["id", "criterion", "status"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "criterion": {"type": "string"}, "status": {"enum": ["pending", "passed", "failed"]}}}}}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
