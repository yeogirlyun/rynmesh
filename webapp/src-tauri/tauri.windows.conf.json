{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Ryn",
  "bundle": {
    "targets": ["nsis"],
    "externalBin": [
      "binaries/rynmesh-peer",
      "binaries/ryn_computer_use"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["English", "SimpChinese"], "displayLanguageSelector": false, "installerHooks": "scripts/windows-installer-hooks.nsh" }
    }
  }
}
