+
+#[test]
+fn ryn_empty_inline_inputs_are_blank_but_text_and_formula_results_are_preserved() {
+    let body = r#"<sheetData><row r="1">
+        <c r="A1" t="inlineStr"><is><t></t></is></c>
+        <c r="B1" t="inlineStr"><is/></c>
+        <c r="C1" t="inlineStr"><v></v></c>
+        <c r="D1" t="inlineStr"><is><t xml:space="preserve"> </t></is></c>
+        <c r="E1" t="inlineStr"><is><t>00123</t></is></c>
+        <c r="F1" t="str"><f>IF(1=1,"","x")</f><v></v></c>
+        <c r="G1" t="inlineStr"><f>IF(1=1,"","x")</f><is><t></t></is></c>
+        <c r="H1" t="inlineStr"><is><r><t></t></r></is></c>
+    </row></sheetData>"#;
+    let (wb, _) = read_xlsx(&minimal(body, &[], "", "")).unwrap();
+    let sh = wb.sheet(0).unwrap();
+    for cell in ["A1", "B1", "C1", "H1"] {
+        assert_eq!(sh.value(at(cell)), Value::Empty, "{cell}");
+    }
+    assert_eq!(sh.value(at("D1")), Value::text(" "));
+    assert_eq!(sh.value(at("E1")), Value::text("00123"));
+    for cell in ["F1", "G1"] {
+        assert_eq!(sh.value(at(cell)), Value::text(""), "{cell}");
+    }
+}
