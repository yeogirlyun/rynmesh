<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.rynmesh.peer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>set -a; source "$HOME/.config/rynmesh/office-mac.env"; exec rynmesh-peer</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/rynmesh-peer.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/rynmesh-peer.err.log</string>
</dict>
</plist>
