[Unit]
Description=Rynmesh SZ reverse tunnel (exposes local peer on HK public IP)
After=network-online.target rynmesh-peer.service
Wants=network-online.target rynmesh-peer.service

[Service]
Type=simple
User=ops
EnvironmentFile=/etc/rynmesh/rynmesh-sz-tunnel.env
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new -i ${SSH_KEY} -R ${HK_PUBLIC_HOST}:${REMOTE_PORT}:127.0.0.1:${LOCAL_PORT} ${HK_SSH_TARGET}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
