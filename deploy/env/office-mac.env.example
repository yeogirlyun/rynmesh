# Rynmesh office-LAN node (macOS). Copy to ~/.config/rynmesh/office-mac.env
# and set RYNMESH_NODE_NAME per host (your-mac / ms-2 / m4-mini / m2-mini).
RYNMESH_REGISTRY_URL=https://registry.rynmesh.ai
RYNMESH_NETWORK_ID=rynmesh-main
RYNMESH_AUTO_REGISTER=1
RYNMESH_PEER_HOST=0.0.0.0
RYNMESH_PEER_PORT=8791
RYNMESH_NODE_NAME=your-mac
# RYNMESH_PEER_PUBLIC_HOST / RYNMESH_PEER_ENDPOINT auto-detect from the LAN IP when unset.
# Optional active-probe resistance on the LAN-facing peer surface:
# RYNMESH_NETWORK_KEY=change-me-shared-secret
# Auto-update: pinned Ed25519 publisher public key(s), comma-separated.
# A node only installs releases signed by one of these. Leave empty to disable auto-update.
RYNMESH_UPDATE_PUBLISHER_KEYS=
# RYNMESH_UPDATE_POLL_S=1800
